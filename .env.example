# ============================================
# isin_nest 環境變數範例（專案根目錄 .env）
# ============================================
# 使用方式：複製為 .env 並依實際環境修改
#   cp .env.example .env
# ============================================

# --------------------------------------------
# Production 必填（部署後端至少需設定）
# --------------------------------------------
# NODE_ENV=production
# PORT=3000
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASS=
# DB_NAME=
# STAFF_PAGE_LOCK_PASSWORD=
# CNC_PATH=
# DWG_PATH=
# NESTING_PATH=
# LIBREOFFICE_PATH=/usr/bin/soffice   # Docker 映像預設未安裝 LibreOffice，見 docker/backend.Dockerfile

# --------------------------------------------
# 後端 / PostgreSQL（主資料庫）
# --------------------------------------------
# DB_HOST：僅在本機直接跑後端（npm/nest，非 Docker）連 Postgres 時使用，例如 localhost。
# docker compose 內的後端服務會固定連到資料庫容器主機名 db，不需也不應在此改為 db。
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=isin

# 備用變數名（部分腳本會使用）
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_DATABASE=isin

# 選填：啟動時自動執行 migration、schema 同步（建議開發以外關閉）
# DB_MIGRATIONS_RUN=false
# DB_SYNC：開發（含 docker compose）可 true；正式環境請 false 並改用 migration
DB_SYNC=true

# --------------------------------------------
# Docker Compose（與根目錄 docker-compose.yml 對齊）
# --------------------------------------------
# 主機對外埠（未設定時 compose 預設：5432 / 3000 / 3001）
# HOST_DB_PORT=5432
# HOST_BACKEND_PORT=3000
# HOST_FRONTEND_PORT=3001   # 僅 docker compose 前端容器對外映射，不影響 npm run frontend:dev
#
# Postgres 容器：compose 會將上方的 DB_USER / DB_PASS / DB_NAME 對應為 POSTGRES_*，
# 後端容器亦使用同一組 DB_*（連線主機 db 已在 compose 內設定），請勿混用不同帳密。
#
# JWT（compose 與本機後端共用；正式環境請改成強隨機字串）
JWT_SECRET=your-secret-key

# --------------------------------------------
# 後端執行環境
# --------------------------------------------
NODE_ENV=development
PORT=3000

# --------------------------------------------
# 來源資料庫（遷移腳本用，如 copy-staff.ts）
# 舊 MySQL 等來源連線，若未設則部分腳本會 fallback 到 DB_*
# --------------------------------------------
# SOURCE_DB_HOST=localhost
# SOURCE_DB_PORT=3306
# SOURCE_DB_USER=root
# SOURCE_DB_PASS=
# SOURCE_DB_NAME=isin2
# SOURCE_DB_USERNAME=root
# SOURCE_DB_PASSWORD=
# SOURCE_DB_DATABASE=isin2

# 獨立 Staff 相容流程使用上面的 SOURCE_DB_* 連舊 MariaDB；未設定時 API 回 503，排程預設關閉
# LEGACY_STAFF_CRON_ENABLED=false
# TIME_CLOCK_IP=192.168.0.223
# TIME_CLOCK_PORT=5005
# TIME_CLOCK_DN=3
# TIME_CLOCK_PASSWORD=0
# TIME_CLOCK_TIMEOUT_MS=5000
# 通用 Slack Incoming Webhook，放在未追蹤的 .env 或部署環境，不要提交實際 URL
# SLACK_WEBHOOK_URL=
# 回報系統（docs/FEEDBACK-AND-LOGS.md）：截圖目錄（預設 files/feedback，容器內請指向持久化的 volume）；
# 新回報要推到的 Slack 頻道 webhook，未設定就不通知
# FEEDBACK_UPLOAD_DIR=files/feedback
# FEEDBACK_SLACK_WEBHOOK_URL=

# --------------------------------------------
# Access 相關（遷移腳本：migrate-quote、migrate-customer、analyze-access）
# --------------------------------------------
# ACCESS_DB_PASSWORD=
# ACCESS_FILE_PATH=legacy/quote.mdb

# --------------------------------------------
# 路徑（後端 CRM / Nesting、LibreOffice）
# --------------------------------------------
# LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# NESTING_PATH=path/nesting
# 薪資 xlsx 輸出目錄（底下再分年份）；容器環境請指向掛載的持久化路徑，未設定時用 files/payroll
# PAYROLL_FILES_PATH=files/payroll
# CNC_PATH=path/cnc
# DWG_PATH=path/dwg

# --------------------------------------------
# 腳本用（可選）
# --------------------------------------------
# create-admin.ts
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# FORCE_UPDATE=false

# migrate-quote-from-access.ts
# SKIP_COUNT=0
# ONLY_MODE=quote|quote-item

# analyze-access.ts（精確選表、樣本列範圍、JSON 輸出等見 scripts/README.md）
# MYSQL_TABLE_NAME=
# ACCESS_TABLE_NAMES=Quote,QuoteDetail
# ACCESS_SAMPLE_ROW_OFFSET=0
# ACCESS_SAMPLE_ROW_LIMIT=5
# ACCESS_SAMPLE_COLUMNS=
# ACCESS_SKIP_SAMPLES=false
# ACCESS_ANALYZE_JSON=false

# staff.controller.ts
# STAFF_PAGE_LOCK_PASSWORD=

# 測試 / CI
# CI=false

# --------------------------------------------
# 前端
# --------------------------------------------
# 本機 Vite dev（npm run frontend:dev / nx serve frontend）；未設定時預設 3001
# FRONTEND_DEV_PORT=3001
#
# 開發時：瀏覽器仍打同源的 /api，由 Vite 轉發到下方主機:PORT（與本檔「後端執行環境」的 PORT 一致）
# 可填本機 localhost、區網 IP（例 192.168.0.10）、或其他機器 hostname
BACKEND_API_HOST=localhost
#
# 建置後或要讓瀏覽器直接連後端（略過 dev proxy）時使用完整 URL，例如區網後端：
# VITE_API_BASE_URL=http://192.168.0.10:3000/api
# 同網域／反向代理仍可用相對路徑：
VITE_API_BASE_URL=/api
#
# 新版 CRM（/crm/*）暫不使用，現行為舊版銷管 /legacy-crm。build 時設為 true 才會出現新版 CRM 的
# 路由與選單（另需 crm_v2 功能權限）；未設定或其他值一律關閉。docker compose 以 build arg 傳入。
# VITE_CRM_V2_ENABLED=false
